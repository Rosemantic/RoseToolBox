{
  "name": "rosetools",
  "version": "3.0.0",
  "private": true,
  "description": "收藏值得再次打开的网站：个人互联网收藏与发现站",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "npm run build && node scripts/dev-server.js",
    "import-bookmarks": "node scripts/import-bookmarks.js",
    "sync-icons": "node scripts/sync-icons.js",
    "optimize-icons": "node scripts/optimize-icons.js",
    "sync": "node scripts/build.js",
    "validate": "node scripts/build.js --check",
    "check-links": "node scripts/check-links.js",
    "release-check": "node scripts/build.js && node scripts/release-check.js",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
